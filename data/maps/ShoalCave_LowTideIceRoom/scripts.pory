// Articuno (July 2026): post-game static encounter in the low-tide ice room.
// Hidden until FLAG_SYS_GAME_CLEAR; hidden again once defeated. Catching it
// also sets FLAG_DEFEATED_ARTICUNO, but the dex caught-flag keeps
// TryResetStationaryLegendaries from ever respawning a caught bird. Beating the
// champion again clears the flag, so a KO'd or fled-from Articuno comes back.

mapscripts ShoalCave_LowTideIceRoom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(ShoalCave_LowTideIceRoom_EventScript_UpdateArticuno)
    }
    MAP_SCRIPT_ON_RESUME {
        call_if_set(FLAG_SYS_CTRL_OBJ_DELETE, ShoalCave_LowTideIceRoom_EventScript_TryRemoveArticuno)
    }
}

script ShoalCave_LowTideIceRoom_EventScript_UpdateArticuno {
    setflag(FLAG_HIDE_SHOAL_CAVE_ARTICUNO)
    if (!flag(FLAG_SYS_GAME_CLEAR)) {
            return
    }
    if (flag(FLAG_DEFEATED_ARTICUNO)) {
            return
    }
    clearflag(FLAG_HIDE_SHOAL_CAVE_ARTICUNO)
    return
}

script ShoalCave_LowTideIceRoom_EventScript_TryRemoveArticuno {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
            return
    }
    removeobject(VAR_LAST_TALKED)
    return
}

script ShoalCave_LowTideIceRoom_EventScript_Articuno {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_ARTICUNO, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_ARTICUNO, 70)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_DEFEATED_ARTICUNO)
        goto(Common_EventScript_RemoveStaticPokemon)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN || var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        setvar(VAR_0x8004, SPECIES_ARTICUNO)
        goto(Common_EventScript_LegendaryFlewAway)
    }
    setflag(FLAG_DEFEATED_ARTICUNO)
    release
    end
}
