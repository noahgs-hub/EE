// Rusturf Tunnel Depths - post-game area behind the hidden cave entrance.
//
// Mewtwo: lv80 static encounter with a fixed moveset (Psychic / Shadow Ball /
// Recover / Calm Mind) applied by the SetScriptedMewtwoMoves special, mirroring
// how Sky Pillar's Rayquaza gets its ORAS moveset. The whole area is already
// gated behind the first Elite Four win (the cave mouth in RusturfTunnel only
// opens on FLAG_SYS_GAME_CLEAR), so no extra gating is needed here.
//
// Outcomes: KO'd or caught -> gone for good (hide flag). Fled -> flies away for
// this visit but returns on the next map load, matching vanilla legendaries.

mapscripts RusturfTunnel_Depths_MapScripts {
    MAP_SCRIPT_ON_RESUME {
        call_if_set(FLAG_SYS_CTRL_OBJ_DELETE, RusturfTunnel_Depths_EventScript_TryRemoveMewtwo)
    }
}

script RusturfTunnel_Depths_EventScript_TryRemoveMewtwo {
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
        return
    }
    setflag(FLAG_HIDE_RUSTURF_TUNNEL_DEPTHS_MEWTWO)
    removeobject(VAR_LAST_TALKED)
    return
}

script RusturfTunnel_Depths_EventScript_Mewtwo {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_MEWTWO, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_MEWTWO, 80)
    special(SetScriptedMewtwoMoves)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(BattleSetup_StartLegendaryBattle)
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_DEFEATED_RUSTURF_TUNNEL_DEPTHS_MEWTWO)
        setflag(FLAG_HIDE_RUSTURF_TUNNEL_DEPTHS_MEWTWO)
        goto(Common_EventScript_RemoveStaticPokemon)
    }
    if (var(VAR_RESULT) == B_OUTCOME_RAN || var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED) {
        setvar(VAR_0x8004, SPECIES_MEWTWO)
        goto(Common_EventScript_LegendaryFlewAway)
    }
    setflag(FLAG_DEFEATED_RUSTURF_TUNNEL_DEPTHS_MEWTWO)
    setflag(FLAG_HIDE_RUSTURF_TUNNEL_DEPTHS_MEWTWO)
    release
    end
}
