script SlateportCity_PokemonCenter_1F_EventScript_ARTUR {
    lock
    faceplayer

    if (flag(FLAG_DAILY_SLATEPORT_ARTUR_STONE)) {
        msgbox(format("That's all I have for today. Come back tomorrow and I'll squeeze out another stone for you!"), MSGBOX_DEFAULT)
        release
        end
    }

    msgbox(format("HNGGHGH! I came here for medical attention but they say its only for these fucking Japanese children game monsters! Oh sorry, I'm ARTUR. I drank too many energy drinks and now I have Kidney stones. AAAAAGGHHHHHH FUCK MY PENIS. OH oh god, thank god. Thank god it passed, here do you want it?"), MSGBOX_DEFAULT)

    switch (var(VAR_SLATEPORT_ARTUR_STONE_INDEX)) {
        case 0:
            giveitem(ITEM_FIRE_STONE)
        case 1:
            giveitem(ITEM_WATER_STONE)
        case 2:
            giveitem(ITEM_THUNDER_STONE)
        case 3:
            giveitem(ITEM_LEAF_STONE)
        case 4:
            giveitem(ITEM_MOON_STONE)
        case 5:
            giveitem(ITEM_SUN_STONE)
        case 6:
            giveitem(ITEM_SHINY_STONE)
        case 7:
            giveitem(ITEM_DAWN_STONE)
        case 8:
            giveitem(ITEM_DUSK_STONE)
        default:
            giveitem(ITEM_ICE_STONE)
    }

    if (var(VAR_RESULT) == FALSE) {
        goto(Common_EventScript_ShowBagIsFull)
    }

    setflag(FLAG_DAILY_SLATEPORT_ARTUR_STONE)
    addvar(VAR_SLATEPORT_ARTUR_STONE_INDEX, 1)
    if (var(VAR_SLATEPORT_ARTUR_STONE_INDEX) > 9) {
        setvar(VAR_SLATEPORT_ARTUR_STONE_INDEX, 0)
    }

    msgbox(format("Oh fuck, please kill me, my dick is bleeding."), MSGBOX_DEFAULT)
    release
    end
}

raw `SlateportCity_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, SlateportCity_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

SlateportCity_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_SLATEPORT_CITY
	call Common_EventScript_UpdateBrineyLocation
	end

SlateportCity_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_SLATEPORT_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

SlateportCity_PokemonCenter_1F_EventScript_Sailor::
	msgbox SlateportCity_PokemonCenter_1F_Text_RaiseDifferentTypesOfPokemon, MSGBOX_NPC
	end

SlateportCity_PokemonCenter_1F_EventScript_Woman::
	msgbox SlateportCity_PokemonCenter_1F_Text_TradedMonWithFriend, MSGBOX_NPC
	end

SlateportCity_PokemonCenter_1F_Text_RaiseDifferentTypesOfPokemon:
	.string "Want a tip for battling?\p"
	.string "I'd say it's raising different kinds\n"
	.string "of POKéMON in a balanced manner.\p"
	.string "It's no good to make just one\n"
	.string "POKéMON strong.\p"
	.string "If it has a type disadvantage,\n"
	.string "it might not stand a chance.$"

SlateportCity_PokemonCenter_1F_Text_TradedMonWithFriend:
	.string "I trade POKéMON with my friends.\p"
	.string "If a traded POKéMON is holding an\n"
	.string "item, it makes me twice as happy!$"
`
